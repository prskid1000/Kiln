<?xml version="1.0" encoding="utf-8"?>
<!-- Network security config can't express a CIDR, so cleartext policy lives in code:
     Http.cleartextAllowed permits only loopback and tailnet (100.64.0.0/10) hosts,
     and every request is checked by an OkHttp interceptor. Everything else is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
