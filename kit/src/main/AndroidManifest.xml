<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every Kiln app may use the network and post notifications (KNet, KNotify). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- KHaptics. A normal permission: granted at install, never asked. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 11+ hides the speech services from apps that don't declare them (rememberSpeaker, KSpeechToText). -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <application>
        <!-- Gives KApp.context from process start, so stores need no Context. -->
        <provider
            android:name="app.kiln.kit.KitInitProvider"
            android:authorities="${applicationId}.kiln.init"
            android:exported="false"
            android:initOrder="1000" />
        <!-- KFiles.share hands files to other apps through this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.kiln.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/kiln_file_paths" />
        </provider>
    </application>
</manifest>
